rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(doctorId) {
      return isSignedIn() && request.auth.uid == doctorId;
    }

    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'zttnlnkc@gmail.com';
    }

    function myPermissions() {
      return exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
        && get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.permissions is list
        ? get(/databases/$(database)/documents/doctors/$(request.auth.uid)).data.permissions
        : [];
    }

    function hasPermission(name) {
      return isSuperAdmin() || name in myPermissions();
    }

    function canViewAccounts() {
      return hasPermission('viewAllAccounts') || hasPermission('managePermissions');
    }

    function canManageUsers() {
      return hasPermission('managePermissions');
    }

    function canManageDefaultForms() {
      return hasPermission('manageDefaultForms');
    }

    function canManageFormCategories() {
      return hasPermission('manageFormCategories');
    }

    function isTargetSuperAdmin() {
      return resource.data.email is string
        && resource.data.email.lower() == 'zttnlnkc@gmail.com';
    }

    function ownerProfileUpdate(doctorId) {
      return isOwner(doctorId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['permissions', 'email']);
    }

    function permissionUpdate() {
      return canManageUsers()
        && !isTargetSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permissions'])
        && request.resource.data.permissions is list;
    }

    function isSafeNewDoctor() {
      return !request.resource.data.keys().hasAny(['permissions'])
        || request.resource.data.permissions.size() == 0;
    }

    match /doctors/{doctorId} {
      allow get, list: if isOwner(doctorId) || canViewAccounts();
      allow create: if isOwner(doctorId) && isSafeNewDoctor();
      allow update: if ownerProfileUpdate(doctorId) || permissionUpdate();
      allow delete: if false;

      match /patients/{patientId} {
        allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
        allow write: if isOwner(doctorId);

        match /notes/{noteId} {
          allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
          allow write: if isOwner(doctorId);
        }

        match /forms/{formId} {
          allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
          allow write: if isOwner(doctorId);
        }

        match /media/{mediaId} {
          allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
          allow write: if isOwner(doctorId);
        }
      }

      match /appointments/{appointmentId} {
        allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
        allow write: if isOwner(doctorId);
      }

      match /formTemplates/{templateId} {
        allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
        allow write: if isOwner(doctorId);
      }

      match /removedMedia/{mediaId} {
        allow read: if isOwner(doctorId) || hasPermission('viewAllAccounts');
        allow create, update: if isOwner(doctorId);
        allow delete: if false;
      }
    }

    match /globalFormTemplates/{templateId} {
      allow read: if isSignedIn();
      allow write: if canManageDefaultForms();
    }

    match /formCategories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if canManageFormCategories();
    }

    function feedbackImagesOk() {
      let urls = request.resource.data.imageUrls;
      return urls is list
        && urls.size() <= 4
        && (urls.size() == 0 || (urls[0] is string && urls[0].size() < 2000))
        && (urls.size() < 2 || (urls[1] is string && urls[1].size() < 2000))
        && (urls.size() < 3 || (urls[2] is string && urls[2].size() < 2000))
        && (urls.size() < 4 || (urls[3] is string && urls[3].size() < 2000));
    }

    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'message',
          'senderUid',
          'senderName',
          'senderEmail',
          'imageUrls',
          'createdAt',
        ])
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.senderName is string
        && request.resource.data.senderEmail is string
        && feedbackImagesOk()
        && request.resource.data.createdAt == request.time;
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'resolvedAt'])
        && request.resource.data.resolved is bool
        && (
          (
            request.resource.data.resolved == true
            && request.resource.data.resolvedAt == request.time
          )
          || (
            request.resource.data.resolved == false
            && !('resolvedAt' in request.resource.data)
          )
        );
      allow delete: if false;
    }
  }
}
